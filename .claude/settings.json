{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/vae_hooks.py\" session", "timeout": 10}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/vae_hooks.py\" guard", "timeout": 10},
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/vae_hooks.py\" precommit", "timeout": 900}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/vae_hooks.py\" stop", "timeout": 20}
        ]
      }
    ]
  }
}
