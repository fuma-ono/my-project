{
  "name": "fx-event-analyzer-backend",
  "version": "0.1.0",
  "description": "FX Event Analyzer Backend API (Node.js + TypeScript + Fastify). Design owned by HQ — see docs/projects/fx-event-analyzer/ (api-design.md, db-design.md).",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --check src tests",
    "format:fix": "prettier --write src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "jobs:cleanup-notifications": "tsx src/jobs/cleanupNotifications.ts",
    "jobs:evaluate-rate-alerts": "tsx src/jobs/evaluateRateAlerts.ts",
    "ingest:official": "tsx src/jobs/ingestOfficial.ts",
    "ingest:official:bls-calendar": "tsx src/jobs/ingestBlsCalendar.ts",
    "ingest:official:eurostat-calendar": "tsx src/jobs/ingestEurostatCalendar.ts",
    "ingest:fomc-schedule": "tsx src/jobs/ingestFomcSchedule.ts",
    "ingest:speeches": "tsx src/jobs/ingestSpeeches.ts",
    "ingest:fx-prices": "tsx src/jobs/ingestFxPrices.ts",
    "ingest:event-reactions": "tsx src/jobs/ingestEventReactions.ts",
    "probe:fx-history": "tsx src/jobs/probeFxHistory.ts",
    "eval:providers": "tsx src/jobs/evalProviders.ts",
    "report:data-quality": "tsx src/jobs/reportDataQuality.ts",
    "check:ecb-observation": "tsx src/jobs/checkEcbObservation.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
