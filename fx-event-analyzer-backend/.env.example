# FX Event Analyzer Backend — required environment variables.
# Copy to .env for local development. Never commit real values (see
# .gitignore) and never send SUPABASE_SERVICE_ROLE_KEY to the iOS client —
# it is Backend-only (Phase 2 instruction §6/§18).

# Server
PORT=
HOST=

# Supabase project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy shared JWT secret used to verify Supabase Auth access tokens
# (HS256) without a network call per request. If the project instead uses
# asymmetric (ES256/JWKS) signing keys, JWT verification needs to switch to
# fetching the project's JWKS — see src/auth/jwt.ts.
SUPABASE_JWT_SECRET=

# Logging
LOG_LEVEL=
