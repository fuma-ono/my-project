# FX Event Analyzer Backend — required environment variables.
# Copy to .env for local development. Never commit real values (see
# .gitignore) and never send SUPABASE_SERVICE_ROLE_KEY to the iOS client —
# it is Backend-only (Phase 2 instruction §6/§18).

# Server
PORT=
HOST=

# Supabase project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# No JWT secret needed: JWT verification fetches the project's own JWKS at
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json (src/auth/jwt.ts), which
# publishes whichever signing key(s) the project actually uses (ES256 —
# the default since Supabase CLI 2.71.1 — or a legacy HS256 secret,
# transparently).

# Logging
LOG_LEVEL=

# GitHub Issues for in-app bug reports (SCR-020, optional). When either is
# empty, bug reports are still stored and auto-replied, just without an
# Issue. Use a fine-grained token limited to that one repository with
# "Issues: Read and write" only. Server-only — never put it in the iOS app.
GITHUB_ISSUES_TOKEN=
# owner/name
GITHUB_ISSUES_REPO=

# Public origin of this API, e.g. https://api.example.com (optional). Used to
# build absolute speaker photo URLs (/api/v1/speaker-photos/...). When empty,
# the request's own protocol://host is used.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Ingestion Worker (npm run ingest:official / ingest:speeches / ingest:fx-prices / eval:providers).
# All optional; a job only uses the providers whose key is set. Never commit
# real values. Where to get each key: docs/projects/fx-event-analyzer/data-sources.md §9.
# Behind a corporate proxy, run the jobs with NODE_USE_ENV_PROXY=1 and
# HTTPS_PROXY set (Node 22.21+ built-in fetch honours them only then).
# ---------------------------------------------------------------------------
# ② Official statistics (free)
FRED_API_KEY=
# Optional: without it BLS API v1 is used (25 queries/day).
BLS_API_KEY=
# ① Paid economic calendar candidates (eval:providers only for now)
TRADING_ECONOMICS_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
# ③ / ⑤ FX 1-minute candles (ingest:fx-prices, eval:providers). A FREE/personal
# Twelve Data key is for internal dev-build checks only (要件定義書 6.4).
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
