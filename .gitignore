# bgm-pipeline
bgm-pipeline/.venv/
bgm-pipeline/output/
bgm-pipeline/__pycache__/
bgm-pipeline/**/__pycache__/

# note-articles/note_publish
note-articles/note_publish/.venv/
note-articles/note_publish/__pycache__/
note-articles/note_publish/credentials/

# secrets / credentials (API keys for YouTube Data API, Meta Graph API, EAS, RevenueCat, AdMob, etc.)
.env
.env.*
!.env.example
*credentials*.json
*token*.json
client_secret*.json
meta_app.json
bgm-pipeline/credentials/
*.pem
*.p12
*.key

# app (Expo/React Native) has its own .gitignore

# dashboard / guide build output (regenerate with each dir's build.py)
docs/dashboard/dashboard.html
docs/dashboard/fonts.py
docs/setup-guide/setup-guide.html
docs/setup-guide/fonts.py
note-articles/queue-page/note-queue.html
note-articles/queue-page/fonts.py

# weekly report slide decks (regenerate with docs/reports/weekly/YYYY-MM-DD.js)
docs/reports/weekly/*.pptx
docs/reports/weekly/node_modules/
docs/reports/weekly/package-lock.json
