# このファイルを .env にコピーして、実際の値を入れてください。
# 値は Supabase プロジェクトの Project Settings > API Keys から取得できます。
# EXPO_PUBLIC_SUPABASE_ANON_KEY には「Publishable and secret API keys」タブの
# Publishable key(sb_publishable_...)を使うこと。「Legacy anon, service_role
# API keys」タブのanonキー(eyJ...の長いJWT)は新しいキー体系への移行で
# 無効化されていることがあるため使わない。
# .env 自体は .gitignore で除外されており、リポジトリにはコミットされません。

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# LINEログイン用。LINE Developersの「チャネル基本設定」にある「Channel ID」
# (これは公開して問題ない値。秘密の「Channel Secret」の方はここには書かず、
# Supabase Edge Functionsのsecretとして設定する。README参照)。
EXPO_PUBLIC_LINE_CHANNEL_ID=xxxxxxxxxx

# Premium課金用(RevenueCat、94回目)。RevenueCatダッシュボード
# (https://app.revenuecat.com)でプロジェクトを作り、App Store Connect/
# Google Play Consoleと連携したあと、「Project settings > API keys」の
# Public app-specific API keyをそれぞれ控える。未設定でもアプリは
# 起動する(その場合は常に無課金として扱われるだけ)。
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx
