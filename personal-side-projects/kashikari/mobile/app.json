{
  "expo": {
    "name": "kashikari",
    "slug": "kashikari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kashikari",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kashikari.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "レシートを撮影して記録に添付するために使用します。",
        "NSPhotoLibraryUsageDescription": "レシートの写真を記録に添付するために使用します。"
      }
    },
    "android": {
      "package": "com.kashikari.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#ff6b4a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "レシートの写真を記録に添付するために使用します。",
          "cameraPermission": "レシートを撮影して記録に添付するために使用します。",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#ff6b4a"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "広告の表示に必要な情報を、あなたの他アプリ・Webサイトでの利用状況と組み合わせないためにご協力ください。"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "@sentry/react-native/expo"
    ],
    "owner": "fuma-ono",
    "extra": {
      "eas": {
        "projectId": "3db8fea4-64ac-4861-b462-df511a81f2d0"
      }
    }
  }
}
