{
  "expo": {
    "name": "kashikari",
    "slug": "kashikari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kashikari",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "レシートを撮影して記録に添付するために使用します。",
        "NSPhotoLibraryUsageDescription": "レシートの写真を記録に添付するために使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ff6b4a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "レシートの写真を記録に添付するために使用します。",
          "cameraPermission": "レシートを撮影して記録に添付するために使用します。"
        }
      ],
      "expo-apple-authentication"
    ]
  }
}
