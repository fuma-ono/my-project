{
  "expo": {
    "name": "kashikari",
    "slug": "kashikari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kashikari",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "レシートを撮影して記録に添付するために使用します。",
        "NSPhotoLibraryUsageDescription": "レシートの写真を記録に添付するために使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ff6b4a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "レシートの写真を記録に添付するために使用します。",
          "cameraPermission": "レシートを撮影して記録に添付するために使用します。"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#ff6b4a"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b2a25440-45da-4f81-86d8-150cbf71328d"
      }
    },
    "owner": "fumaono"
  }
}
