# Generated by XcodeGen from project.yml — never commit the generated project.
# CI and local development both run `xcodegen generate` before building.
*.xcodeproj/
*.xcworkspace/
# Info.plist content is fully specified by project.yml's `info:` block;
# XcodeGen writes the actual file to this path on every `generate`.
FXEventAnalyzer/Resources/Info.plist

# Xcode
xcuserdata/
DerivedData/
.build/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# Swift Package Manager
.swiftpm/
Package.resolved

# Local secrets — never commit Supabase credentials or any other secret.
# CI injects SUPABASE_URL / SUPABASE_ANON_KEY via GitHub Actions secrets instead.
.env
.env.*
!.env.example
Config/Local.xcconfig
