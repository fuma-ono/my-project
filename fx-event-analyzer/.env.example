# FX Event Analyzer — required environment variables.
#
# These are consumed by xcodebuild as build-setting overrides (see
# .github/workflows/fx-event-analyzer-ios-build.yml), not read directly by
# the app at build time from a .env file. This file exists purely to
# document what must be set — copy the values into GitHub Actions repo
# secrets (FX_SUPABASE_URL / FX_SUPABASE_ANON_KEY / FX_API_BASE_URL) or
# pass them as -destination-agnostic xcodebuild overrides for local builds.
#
# Never commit real values. The app must run (and Auth/Backend calls must
# fail gracefully, not crash) when these are unset — see
# FXEventAnalyzer/Auth/SupabaseConfig.swift and
# Networking/APIClient.swift's defaultBaseURLProvider.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# The Backend's own base URL (e.g. https://api.example.com/api/v1) — see
# fx-event-analyzer-backend/. Separate from SUPABASE_URL above.
API_BASE_URL=
